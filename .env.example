# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAIRGATE_API_KEY: VTU Provider API Key (server-side only, never exposed to client)
PAIRGATE_API_KEY=""

# PAIRGATE_BASE_URL: Base API URL for VTU telecom provider
PAIRGATE_BASE_URL="https://pairgate.com/api/v1"

# PAIRGATE_ENVIRONMENT: "sandbox" for development/testing or "live" for production
PAIRGATE_ENVIRONMENT="live"

# PAYSTACK_SECRET_KEY: Paystack Secret Key (server-side only, NEVER exposed to frontend)
PAYSTACK_SECRET_KEY=""

# PAYSTACK_PUBLIC_KEY: Paystack Public Key (for frontend popup initialization)
PAYSTACK_PUBLIC_KEY=""

# BREVO_API_KEY: Brevo (Sendinblue) Transactional Email API Key for verification emails
BREVO_API_KEY=""

# BREVO_SENDER_EMAIL: Sender email address configured in Brevo domain settings
BREVO_SENDER_EMAIL="auth@grobaax.app"

# BREVO_SENDER_NAME: Display name for system verification emails
BREVO_SENDER_NAME="Grobaax Arena Security"

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

